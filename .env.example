# ==============================================================================
# MailLog Studio for Outlook — 시크릿 / API 키 / 로컬 에이전트 전용 .env 파일
# ==============================================================================
# 주의: 이 파일에는 API 키, OAuth 시크릿, 메일 비밀번호 등 민감한 정보만 보관합니다.
# 일반 앱·플러그인·AI 모델명·외부 폴더 경로 설정은 config.json에서 분리 관리합니다.
# 실제 운영 시 이 파일을 복사해 .env로 저장하고 로컬 에이전트가 값을 채우세요 (Git 커밋 금지).

# [1. 호스팅 URL] Outlook manifest.xml 및 Microsoft OAuth 콜백 기준 HTTPS 주소
APP_URL="MY_APP_URL"

# [2. AI 엔진 & 하이브리드 GCP 크레딧 우선 소진 — 사용할 엔진의 키만 입력]
# 2-1) 1순위 실시간 요약·업무일지·블로그: Gemini 4 Hydrogen API (13.43만 원 크레딧 · 실패 시 2순위 자동 폴백)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
# 2-2) 1순위 과거 누적 메일 RAG 검색: Vertex AI Agent Builder / Discovery Engine (143만 원 크레딧 · Cloudflare Worker 경유 권장)
AGENT_BUILDER_WORKER_URL=""
AGENT_BUILDER_WORKER_TOKEN=""
GCP_PROJECT_ID=""
AGENT_BUILDER_LOCATION="global"
AGENT_BUILDER_DATA_STORE_ID=""
AGENT_BUILDER_SERVING_CONFIG="default_search"
AGENT_BUILDER_ACCESS_TOKEN=""
GCS_MAIL_ARCHIVE_BUCKET=""
# 체험판 만료일(2027-02-02) 이후 자동 과금 차단 가드 (기본값 true — 만료 후 Gemini/로컬로 자동 전환)
AGENT_BUILDER_CREDIT_EXPIRY_DATE="2027-02-02"
AGENT_BUILDER_HARD_STOP_AFTER_EXPIRY="true"
# 2-3) 2순위 무료 Groq API (openai/gpt-oss-120b 8K TPM Map-Reduce + whisper-large-v3-turbo STT): https://console.groq.com/keys
GROQ_API_KEY=""
# 2-4) 2순위 Anthropic Claude API (정밀 한국어 업무 일지·회의록·블로그): https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# 2-5) 2순위 OpenAI ChatGPT API (문서·스레드 분석 + whisper-1 STT): https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# [3. Microsoft 365 Outlook 실시간 메일함 연동 (Azure Entra ID OAuth / MSAL NAA)]
# Azure Web Redirect URI: ${APP_URL}/auth/microsoft/callback
# Azure SPA (MSAL NAA) Redirect URI: brk-multihub://<호스트-도메인>
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# [4. 이미 보유한 외부 PDF / Excel 분석 프로젝트 폴더 직접 연동 (선택, config.json보다 우선)]
# 기존 프로젝트 폴더 경로만 입력하면 내장 파서(pdf-parse/exceljs) 대신 해당 엔진을 우선 호출합니다.
# 커스텀 실행 명령이 필요하면 {file} 플레이스홀더를 사용하세요 (예: python analyze.py {file} --json)
EXTERNAL_PDF_ENGINE_DIR=""
EXTERNAL_PDF_ENGINE_CMD=""
EXTERNAL_EXCEL_ENGINE_DIR=""
EXTERNAL_EXCEL_ENGINE_CMD=""

# [5. 메일플러그(Mailplug) / 사내 웹메일 IMAP · POP3 · SMTP 연동 (로컬 에이전트 전용)]
# 웹 브라우저에는 노출되지 않으며, 로컬 에이전트가 imapflow / nodemailer 동기화 워커를 붙일 때 사용합니다.
MAIL_PROVIDER_PRESET="mailplug"
MAIL_PROTOCOL="imap"
MAIL_IMAP_HOST="imap.mailplug.co.kr"
MAIL_IMAP_PORT="993"
MAIL_POP3_HOST="pop3.mailplug.co.kr"
MAIL_POP3_PORT="995"
MAIL_SMTP_HOST="smtp.mailplug.co.kr"
MAIL_SMTP_PORT="465"
MAIL_TLS="true"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_LOCAL_EXPORT_DIR="./data/mail-archives"

# [6. 선택: 사내 자체 호스팅 시 config.json 및 EMV 볼트 관리 보호 비밀번호 · 암호화 마스터 키]
CONFIG_ADMIN_PASSWORD=""
EMV_MASTER_KEY=""
