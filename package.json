{
  "name": "bmail-outlook-ai",
  "private": true,
  "version": "1.3.0",
  "description": "Bmail — Outlook AI 워크스페이스 (로컬 PST/POP3/SMTP 완전 대체 + Cloudflare Workers 게이트웨이)",
  "author": "Seastar Work",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.mjs",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs && esbuild src/services/pstMigrationWorker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/pst-worker.mjs",
    "build:exe": "npm run build && npm run build:server && electron-builder --config desktop/electron-builder.json --win nsis",
    "release:publish": "node scripts/publish-release.mjs",
    "groq:keys": "node scripts/set-groq-keys.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pst-extractor": "^1.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "d3": "^7.9.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
